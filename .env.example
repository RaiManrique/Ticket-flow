# Copia este archivo como ".env" y cambia TODAS las contraseñas antes de levantar Docker.
# PowerShell: Copy-Item .env.example .env

# ── Administrador MongoDB (solo equipo TicketFlow) ──────────────────────────
# Usar minimo 24 caracteres: mayusculas, minusculas, numeros y simbolos.
# Ejemplo de generacion en PowerShell:
#   -join ((48..57)+(65..90)+(97..122)+33,35,36,37,38,42,63 | Get-Random -Count 32 | % {[char]$_})
MONGO_ROOT_USER=ticketflow_admin
MONGO_ROOT_PASSWORD=CAMBIAR_POR_CONTRASENA_FUERTE_DE_32_CARACTERES!

# ── Usuario de aplicacion (futuro backend Node.js) ───────────────────────────
# Permisos limitados: solo lectura/escritura en ticketflow_social.
MONGO_APP_USER=ticketflow_app
MONGO_APP_PASSWORD=CAMBIAR_OTRA_CONTRASENA_FUERTE_DIFERENTE!

# ── Red: quien puede conectarse desde fuera del contenedor ───────────────────
# Mongo: dejar en 127.0.0.1 (solo esta PC; la API usa mongo:27017 dentro de Docker).
# Web/API: 0.0.0.0 expone el puerto en todas las interfaces (Postman, otra PC en LAN).
# 127.0.0.1 en web/api = solo localhost (mas restrictivo).
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27018
API_BIND_IP=0.0.0.0
WEB_BIND_IP=0.0.0.0

# ── Capas de aplicacion y presentacion ───────────────────────────────────────
API_PORT=3000
WEB_PORT=8090

# Usar true cuando el usuario MONGO_APP_USER ya exista en MongoDB
MONGO_USE_APP_USER=false

# Contrasena de demostracion para login en el frontend
DEMO_USER_PASSWORD=TicketFlow2026

# Firma de tokens JWT (minimo 32 caracteres en produccion)
JWT_SECRET=CAMBIAR_POR_SECRETO_JWT_LARGO_Y_ALEATORIO

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:4200,http://localhost:4200
