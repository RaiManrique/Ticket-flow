# =============================================================================
# TicketFlow — plantilla de entorno LOCAL (desarrollo en equipo)
# =============================================================================
# El archivo .env NO se sube a Git (.gitignore). Cada persona debe crearlo:
#
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# IMPORTANTE: Las contraseñas de abajo deben coincidir con las que MongoDB
# guardó la PRIMERA vez que se creó la carpeta BD/. Si cambias .env después
# de levantar Mongo, ver README → "Mongo Authentication failed".
# =============================================================================

# ── MongoDB (mismos valores por defecto que docker-compose.yml) ─────────────
MONGO_ROOT_USER=ticketflow_admin
MONGO_ROOT_PASSWORD=TicketFlow2026DevMongo!

MONGO_APP_USER=ticketflow_app
MONGO_APP_PASSWORD=TicketFlow2026DevApp!

# false = la API usa el usuario root (recomendado en dev local)
MONGO_USE_APP_USER=false

# ── Red / puertos ───────────────────────────────────────────────────────────
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27018
API_BIND_IP=0.0.0.0
WEB_BIND_IP=0.0.0.0
API_PORT=3000
WEB_PORT=8090

# ── App ─────────────────────────────────────────────────────────────────────
DEMO_USER_PASSWORD=TicketFlow2026
JWT_SECRET=ticketflow-dev-secret-cambiar-en-produccion

CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:4200,http://localhost:4200

# ── DigitalOcean Spaces (subida de fotos/videos) — opcional para login/eventos
# Sin estas claves: la app arranca, pero /api/upload fallará.
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=ticketflow-media
DO_SPACES_KEY=PEDIR_AL_EQUIPO_O_CREAR_EN_DO
DO_SPACES_SECRET=PEDIR_AL_EQUIPO_O_CREAR_EN_DO
