          ]
        },
        {
          "name": "✅ Register valido (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman_{{$timestamp}}@ticketflow.test\",\n  \"username\": \"pm{{$timestamp}}\",\n  \"nombre_completo\": \"Usuario Postman SO\",\n  \"password\": \"TicketFlow2026!\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          },
