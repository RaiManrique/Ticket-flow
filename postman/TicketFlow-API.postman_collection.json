{
  "info": {
    "_postman_id": "ticketflow-api-collection",
    "name": "TicketFlow API",
    "description": "Coleccion TicketFlow API.\n\nIMPORTANTE — El token NO se escribe a mano:\n1. Importa el entorno TicketFlow-Local.postman_environment.json\n2. Activa ese entorno (arriba a la derecha)\n3. docker compose up -d mongo api\n4. Ejecuta Login usuario → el campo token se llena solo\n5. Ejecuta Verificar token (GET /me) para confirmar\n\nRutas protegidas usan: Authorization: Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:3000/api" },
    { "key": "demo_password", "value": "TicketFlow2026" },
    { "key": "token", "value": "" },
    { "key": "evento_id", "value": "64f0b0010000000000000003" },
    { "key": "publicacion_id", "value": "" },
    { "key": "media_url", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mongo conectado', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('ok');",
                  "  pm.expect(j.mongo).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login usuario (rai_manrique)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"rai_manrique\",\n  \"password\": \"{{demo_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('Token JWT en respuesta', () => {",
                  "    pm.expect(j.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(j.token.split('.').length).to.eql(3);",
                  "  });",
                  "  pm.collectionVariables.set('token', j.token);",
                  "  pm.environment.set('token', j.token);",
                  "  console.log('Token guardado para', j.user.username);",
                  "  console.log('Usa Authorization: Bearer ' + j.token.substring(0, 24) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verificar token (GET /me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "description": "Ejecuta DESPUES del Login. Si {{token}} esta vacio, fallara con 401."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const t = pm.environment.get('token') || pm.collectionVariables.get('token');",
                  "if (!t) {",
                  "  console.warn('Sin token: ejecuta primero Login usuario');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token valido (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const u = pm.response.json();",
                  "  pm.test('Usuario en sesion', () => pm.expect(u.username).to.be.a('string'));",
                  "  console.log('Sesion OK:', u.username, '| rol:', u.rol);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login organizador (victor_arapa)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"victor_arapa\",\n  \"password\": \"{{demo_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.token);",
                  "  pm.environment.set('token', j.token);",
                  "}",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login admin (admin_ticketflow)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin_ticketflow\",\n  \"password\": \"{{demo_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.token);",
                  "  pm.environment.set('token', j.token);",
                  "}",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me (sesion actual)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Register usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test_fan_{{$timestamp}}@example.com\",\n  \"username\": \"test_fan_{{$timestamp}}\",\n  \"nombre_completo\": \"Fan de Prueba\",\n  \"password\": \"MiClave12345\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Register organizador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"org_{{$timestamp}}@example.com\",\n  \"username\": \"org_{{$timestamp}}\",\n  \"nombre_completo\": \"Productora Demo\",\n  \"password\": \"MiClave12345\"\n}"
            },
            "url": "{{base_url}}/auth/register-organizer"
          }
        }
      ]
    },
    {
      "name": "02 - Eventos (publico)",
      "item": [
        {
          "name": "Listar eventos publicados",
          "request": { "method": "GET", "url": "{{base_url}}/eventos" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const list = pm.response.json();",
                  "  if (list.length) {",
                  "    pm.collectionVariables.set('evento_id', list[0]._id);",
                  "    pm.environment.set('evento_id', list[0]._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Detalle evento",
          "request": { "method": "GET", "url": "{{base_url}}/eventos/{{evento_id}}/detalle" }
        },
        {
          "name": "Evento por ID",
          "request": { "method": "GET", "url": "{{base_url}}/eventos/{{evento_id}}" }
        },
        {
          "name": "Confirmar asistencia (toggle)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/eventos/{{evento_id}}/asistir"
          }
        }
      ]
    },
    {
      "name": "03 - Asistencia (usuario auth)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const t = pm.environment.get('token') || pm.collectionVariables.get('token');",
              "if (!t) console.warn('Ejecuta Login en 01 - Auth antes de probar asistencia');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "item": [
        {
          "name": "Toggle asistencia a evento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/eventos/{{evento_id}}/asistir"
          }
        }
      ]
    },
    {
