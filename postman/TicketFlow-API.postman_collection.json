          "name": "❌ Register invalido (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mal\",\n  \"username\": \"x\",\n  \"nombre_completo\": \"a\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
