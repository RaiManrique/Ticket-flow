              }
            }
          ]
        },
        {
          "name": "Crear publicacion con imagen (media_urls)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Publicacion con imagen desde Postman — prueba Spaces\",\n  \"media_urls\": [\"{{media_url}}\"]\n}"
            },
            "url": "{{base_url}}/social/publicaciones",
            "description": "Ejecuta antes **06 - Upload imagen** para llenar {{media_url}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('publicacion_id', j._id);",
                  "  pm.environment.set('publicacion_id', j._id);",
                  "}",
                  "pm.test('Publicacion con media OK', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
