    {
      "name": "05 - Admin / Organizador",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
      "item": [
        {
          "name": "Dashboard",
          "request": { "method": "GET", "url": "{{base_url}}/admin/dashboard" }
        },
        {
          "name": "Eventos (staff)",
          "request": { "method": "GET", "url": "{{base_url}}/admin/eventos" }
        },
        {
          "name": "Detalle evento (staff)",
          "request": { "method": "GET", "url": "{{base_url}}/admin/eventos/{{evento_id}}/detalle" }
        },
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Evento Postman Demo\",\n  \"descripcion\": \"Creado desde la coleccion de pruebas\",\n  \"categoria\": \"concierto\",\n  \"ciudad\": \"Lima\",\n  \"fecha_evento\": \"2026-12-01T20:00:00.000Z\"\n}"
            },
            "url": "{{base_url}}/admin/eventos"
          }
        },
        {
          "name": "Usuarios (solo admin)",
