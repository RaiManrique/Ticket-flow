        {
          "name": "Flujo completo storage (orden sugerido)",
          "description": "1. Register valido o Login\n2. Upload imagen\n3. Crear publicacion con imagen\n4. Eliminar publicacion",
          "item": [
            {
              "name": "1 Login usuario",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"login\": \"rai_manrique\",\n  \"password\": \"{{demo_password}}\"\n}" },
                "url": "{{base_url}}/auth/login"
              },
              "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code===200){pm.environment.set('token',pm.response.json().token);}"], "type": "text/javascript" } }]
            },
            {
              "name": "2 Upload imagen",
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
                "method": "POST",
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
                "url": "{{base_url}}/upload"
              },
              "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code===200){pm.environment.set('media_url',pm.response.json().url);}"], "type": "text/javascript" } }]
            },
            {
              "name": "3 Crear publicacion con imagen",
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"texto\": \"Prueba Postman upload Spaces {{$timestamp}}\",\n  \"media_urls\": [\"{{media_url}}\"]\n}" },
                "url": "{{base_url}}/social/publicaciones"
              },
              "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code===201){pm.environment.set('publicacion_id',pm.response.json()._id);}"], "type": "text/javascript" } }]
            },
            {
              "name": "4 Eliminar publicacion",
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
                "method": "DELETE",
                "url": "{{base_url}}/social/publicaciones/{{publicacion_id}}"
              },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('OK',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }]
            }
          ]
        }
      ]
    },
