    {
      "name": "06 - Upload y Demo",
      "item": [
        {
          "name": "Demo login info",
          "request": { "method": "GET", "url": "{{base_url}}/demo/login-info" }
        },
        {
          "name": "Upload imagen (Spaces)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Selecciona una imagen JPG/PNG (max 10MB)"
                }
              ]
            },
            "url": "{{base_url}}/upload",
            "description": "Sube imagen a DigitalOcean Spaces. Guarda la URL en {{media_url}}.\nRequiere token (Login primero)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload OK (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('URL en Spaces', () => {",
                  "    pm.expect(j.url).to.include('digitaloceanspaces.com');",
                  "  });",
                  "  pm.collectionVariables.set('media_url', j.url);",
                  "  pm.environment.set('media_url', j.url);",
                  "  console.log('media_url guardada:', j.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
